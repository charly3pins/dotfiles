{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "prompt.skills": "ctrl+k"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "tabs": {
    "scope": "global"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "animations": true
}
